# Leave DATABASE_URL unset for an ISOLATED local SQLite demo.
# Set PostgreSQL URL ONLY after confirming the live six-table schema and roles.
DATABASE_URL=sqlite:///./kanban-demo.sqlite3
KANBAN_API_URL=http://127.0.0.1:8000
TEAM_TODO_ACTOR_ID=REPLACE_WITH_SEEDED_ACTOR_UUID
# Mandatory for any remotely reachable service; never commit real secrets.
TEAM_TODO_API_KEY=REPLACE_WITH_RANDOM_SECRET
# Optional Data API companion (requires correct RLS/JWT permissions).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=...
# SUPABASE_ACCESS_TOKEN=...
# Use ONLY for an isolated loopback demo when no API key is configured:
# KANBAN_ALLOW_INSECURE_DEMO=1
